{
  "name": "MentorshipSession",
  "type": "object",
  "properties": {
    "enterprise_id": {
      "type": "string",
      "title": "Enterprise"
    },
    "mentor_id": {
      "type": "string",
      "title": "Mentor"
    },
    "session_date": {
      "type": "string",
      "format": "date",
      "title": "Session date"
    },
    "topic": {
      "type": "string",
      "title": "Topic"
    },
    "challenge": {
      "type": "string",
      "title": "Challenge"
    },
    "guidance": {
      "type": "string",
      "title": "Guidance"
    },
    "actions": {
      "type": "string",
      "title": "Actions"
    },
    "follow_up": {
      "type": "string",
      "title": "Follow up"
    },
    "follow_up_date": {
      "type": "string",
      "format": "date",
      "title": "Follow up date"
    }
  },
  "required": [
    "enterprise_id",
    "topic"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "mentor"
          }
        },
        {
          "user_condition": {
            "role": "practitioner"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}